# Database
DATABASE_URL=postgresql://fides:CHANGEME@localhost:5432/fides
POSTGRES_USER=fides
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=fides
DB_POOL_MAX=10

# Service ports
DISCOVERY_PORT=3100
TRUST_GRAPH_PORT=3200
REGISTRY_PORT=7346
RELAY_PORT=7347
AGENTD_PORT=7345

# Service URLs (for inter-service communication)
DISCOVERY_URL=http://localhost:3100
TRUST_GRAPH_URL=http://localhost:3200
REGISTRY_URL=http://localhost:7346

# API Authentication (all services)
# Leave unset for development mode (auth disabled)
# Set in production to require X-API-Key header on mutating endpoints
SERVICE_API_KEY=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# CORS (required in production — set to your frontend origin)
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Environment
NODE_ENV=development
