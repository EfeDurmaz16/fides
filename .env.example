# Database
DATABASE_URL=postgresql://fides:CHANGEME@localhost:5432/fides
POSTGRES_USER=fides
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=fides
DB_POOL_MAX=10

# discovery store
DISCOVERY_DB_AUTO_MIGRATE=true

# agentd authority store
# file = local JSON snapshot, postgres = durable production authority state
AGENTD_AUTHORITY_STORE=file
AGENTD_DATABASE_URL=
AGENTD_DB_AUTO_MIGRATE=true
AGENTD_DB_POOL_MAX=10
AGENTD_STATE_STORE_PATH=

# registry store
# file = local JSON snapshot, postgres = durable production registry state
REGISTRY_STORE=file
REGISTRY_DATABASE_URL=
REGISTRY_DB_AUTO_MIGRATE=true
REGISTRY_DB_POOL_MAX=10
REGISTRY_STORE_PATH=

# Service ports
DISCOVERY_PORT=3100
TRUST_GRAPH_PORT=3200
POLICY_ENGINE_PORT=3300
REGISTRY_PORT=7346
RELAY_PORT=7347
AGENTD_PORT=7345
PLATFORM_API_PORT=3600

# Service URLs (for inter-service communication)
DISCOVERY_URL=http://localhost:3100
TRUST_GRAPH_URL=http://localhost:3200
POLICY_ENGINE_URL=http://localhost:3300
REGISTRY_URL=http://localhost:7346
RELAY_URL=http://localhost:7347
AGENTD_URL=http://localhost:7345

# API Authentication (all services)
# Leave unset for development mode (auth disabled)
# Set in production to require X-API-Key header on mutating endpoints
SERVICE_API_KEY=
# Optional discovery scoped keys. When set, this takes precedence over
# SERVICE_API_KEY for discovery write routes and must be valid JSON.
# DISCOVERY_API_KEYS=[{"key":"discovery-operator-key","scopes":["discovery:identities:register","discovery:identities:domain:verify","discovery:identities:organization-domain:verify","discovery:agents:register","discovery:agents:update","discovery:agents:heartbeat","discovery:agents:delete"]}]
DISCOVERY_API_KEYS=
# Optional platform-api scoped keys. When set, this takes precedence over
# SERVICE_API_KEY for platform-api routes and must be valid JSON.
# PLATFORM_API_KEYS=[{"key":"operator-key","scopes":["platform:topology:read","platform:passkeys:read","platform:passkeys:write","platform:trust-anchors:read","platform:trust-anchors:write"]}]
PLATFORM_API_KEYS=
# Optional agentd scoped keys. When set, this takes precedence over
# SERVICE_API_KEY for agentd mutating /v1 routes and must be valid JSON.
# AGENTD_API_KEYS=[{"key":"agentd-operator-key","scopes":["agentd:policy:evaluate","agentd:sessions:write","agentd:authority:write","agentd:authorize:write","agentd:evidence:write","agentd:attest:write","agentd:killswitch:write"]}]
AGENTD_API_KEYS=
# Optional registry scoped keys. When set, this takes precedence over
# SERVICE_API_KEY for registry mutating /v1 routes and must be valid JSON.
# REGISTRY_API_KEYS=[{"key":"registry-operator-key","scopes":["registry:cards:publish","registry:cards:delete","registry:cards:mode:write","registry:cards:metadata:write"]}]
REGISTRY_API_KEYS=
# Optional relay scoped keys. When set, this takes precedence over
# SERVICE_API_KEY for relay mutating /v1 routes and must be valid JSON.
# RELAY_API_KEYS=[{"key":"relay-operator-key","scopes":["relay:messages:submit","relay:messages:delete"]}]
RELAY_API_KEYS=
# Optional policy-engine scoped keys. When set, this takes precedence over
# SERVICE_API_KEY for policy evaluation routes and must be valid JSON.
# POLICY_ENGINE_API_KEYS=[{"key":"policy-operator-key","scopes":["policy:evaluate"]}]
POLICY_ENGINE_API_KEYS=
# Optional trust-graph scoped keys. When set, this takes precedence over
# SERVICE_API_KEY for trust-graph write routes and must be valid JSON.
# TRUST_GRAPH_API_KEYS=[{"key":"trust-operator-key","scopes":["trust:edges:write","trust:capability:invoke","trust:incidents:write","trust:revocations:write"]}]
TRUST_GRAPH_API_KEYS=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# CORS (required in production — set to your frontend origin)
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Environment
NODE_ENV=development
