{
  "name": "fides",
  "version": "0.1.0",
  "private": true,
  "description": "Decentralized Trust & Authentication Protocol for AI Agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EfeDurmaz16/fides"
  },
  "keywords": ["fides", "trust", "authentication", "ai-agents", "did", "decentralized-identity"],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "package:hygiene": "node scripts/check-package-hygiene.mjs",
    "verify": "pnpm package:hygiene && pnpm build && pnpm lint && pnpm typecheck && pnpm test",
    "verify:quick": "pnpm lint && pnpm test",
    "ci:local": "pnpm verify",
    "dev": "turbo run dev --parallel",
    "clean": "turbo run clean",
    "demo": "tsx examples/demo.ts",
    "demo:authority": "tsx scripts/authority-path-demo.ts",
    "demo:authority:processes": "tsx scripts/multiprocess-authority-demo.ts",
    "smoke:docker": "tsx scripts/docker-compose-smoke.ts"
  },
  "dependencies": {
    "@fides/core": "workspace:*",
    "@fides/evidence": "workspace:*",
    "@fides/guard": "workspace:*",
    "@fides/policy": "workspace:*",
    "@fides/runtime": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "pnpm@10.18.1"
}
