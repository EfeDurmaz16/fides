{
  "name": "@fides/cli",
  "version": "0.1.0",
  "description": "FIDES CLI - Command-line interface for the FIDES trust protocol",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EfeDurmaz16/fides",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/EfeDurmaz16/fides#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "fides": "./dist/index.js",
    "agentd": "./dist/index.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "fides": "node dist/index.js",
    "agentd": "node dist/index.js",
