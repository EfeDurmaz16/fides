{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "env": [
        "AGENTD_DATABASE_URL",
        "AGENTD_POSTGRES_TEST_REQUIRED",
        "DISCOVERY_DATABASE_URL",
        "DISCOVERY_DB_AUTO_MIGRATE",
        "DATABASE_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
